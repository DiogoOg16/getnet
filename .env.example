# Demo authentication tokens: JSON mapping token strings to user IDs.
# Development only: these values are public examples and must be replaced in any real environment.
# User IDs starting with "atendente_" act as attendants and can assume and complete handoff tickets.
GETNET_DEMO_AUTH_TOKENS='{"demo-token-cliente1988":"cliente1988","demo-token-cliente2001":"cliente2001","demo-token-atendente_01":"atendente_01"}'

# Optional: local Ollama configuration
OLLAMA_URL=http://ollama:11434
